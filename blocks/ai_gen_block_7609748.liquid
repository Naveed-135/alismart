{% doc %}
  @prompt
    New brand section (v7). Three manual collection_list fields
    (extra_collections_1/2/3, each capped at 50 by Shopify = 150 total),
    merged using the plain delimited-string technique (capture + split +
    sort + uniq) that proved reliable on this store — not push/concat/uniq
    on arrays of collection objects, which silently returned empty
    results. Letter-grouping keeps each section's HTML fully
    self-contained within one loop pass (avoids theme-check's unclosed
    element error).
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-brands-page-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-brands-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-brands-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-brands-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px;
    font-weight: 700;
  }

  .ai-brands-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-brands-debug-{{ ai_gen_id }} {
    background: #fff59d;
    border: 2px dashed #f9a825;
    color: #333;
    padding: 10px 14px;
    font-size: 13px;
    font-family: monospace;
    border-radius: 6px;
    margin-bottom: 20px;
    text-align: center;
  }

  .ai-brands-search-wrapper-{{ ai_gen_id }} {
    max-width: 600px;
    margin: 0 auto 40px;
    position: relative;
  }

  .ai-brands-search-input-{{ ai_gen_id }} {
    width: 100%;
    padding: 16px 50px 16px 20px;
    font-size: 16px;
    border: 2px solid {{ block.settings.search_border_color }};
    border-radius: {{ block.settings.search_border_radius }}px;
    background-color: {{ block.settings.search_bg_color }};
    color: {{ block.settings.text_color }};
    transition: border-color 0.3s ease;
  }

  .ai-brands-search-input-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.search_focus_color }};
  }

  .ai-brands-search-icon-{{ ai_gen_id }} {
    position: absolute;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: {{ block.settings.text_color }};
    opacity: 0.5;
    pointer-events: none;
  }

  .ai-brands-az-nav-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: 50px;
    padding: 20px;
    background-color: {{ block.settings.az_nav_bg_color }};
    border-radius: {{ block.settings.az_nav_border_radius }}px;
  }

  .ai-brands-az-letter-{{ ai_gen_id }} {
    min-width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.az_letter_color }};
    background-color: {{ block.settings.az_letter_bg }};
    border-radius: {{ block.settings.az_letter_border_radius }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    border: 2px solid transparent;
  }

  .ai-brands-az-letter-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.az_letter_hover_bg }};
    color: {{ block.settings.az_letter_hover_color }};
    transform: translateY(-2px);
  }

  .ai-brands-az-letter-{{ ai_gen_id }}.disabled {
    opacity: 0.3;
    cursor: not-allowed;
    pointer-events: none;
  }

  .ai-brands-alphabet-section-{{ ai_gen_id }} {
    margin-bottom: 60px;
  }

  .ai-brands-alphabet-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.alphabet_heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.alphabet_heading_color }};
    margin: 0 0 24px;
    padding-bottom: 12px;
    border-bottom: 3px solid {{ block.settings.alphabet_border_color }};
    scroll-margin-top: 100px;
  }

  .ai-brands-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-brands-card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    background-color: {{ block.settings.card_bg_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: all 0.3s ease;
    text-decoration: none;
    border: 1px solid {{ block.settings.card_border_color }};
  }

  .ai-brands-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .ai-brands-card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-top: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background-color: {{ block.settings.image_placeholder_bg }};
  }

  .ai-brands-card-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-brands-card-{{ ai_gen_id }}:hover .ai-brands-card-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-brands-card-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.image_placeholder_bg }};
  }

  .ai-brands-card-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-brands-card-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    text-align: center;
  }

  .ai-brands-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.card_title_color }};
    margin: 0;
  }

  .ai-brands-no-results-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.text_color }};
    font-size: 18px;
  }

  .ai-brands-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.text_color }};
    font-size: 18px;
  }

  @media screen and (max-width: 989px) {
    .ai-brands-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-brands-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-brands-alphabet-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.alphabet_heading_size }}px * 0.85);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-brands-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-brands-az-nav-{{ ai_gen_id }} {
      gap: 6px;
      padding: 15px;
    }

    .ai-brands-az-letter-{{ ai_gen_id }} {
      min-width: 36px;
      height: 36px;
      font-size: 14px;
    }

    .ai-brands-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.7);
    }

    .ai-brands-alphabet-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.alphabet_heading_size }}px * 0.75);
    }

    .ai-brands-card-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.card_title_size }}px * 0.9);
    }
  }
{% endstyle %}

<all-brands-page-{{ ai_gen_id }} class="ai-brands-page-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-brands-container-{{ ai_gen_id }}">
    <div class="ai-brands-header-{{ ai_gen_id }}">
      {% if block.settings.page_title != blank %}
        <h1 class="ai-brands-title-{{ ai_gen_id }}">{{ block.settings.page_title }}</h1>
      {% endif %}
      {% if block.settings.page_subtitle != blank %}
        <p class="ai-brands-subtitle-{{ ai_gen_id }}">{{ block.settings.page_subtitle }}</p>
      {% endif %}
    </div>

    {% comment %} ===== MERGE 3 MANUAL COLLECTION LISTS (50 each = 150 total) VIA PLAIN STRINGS ===== {% endcomment %}
    {% assign list1 = block.settings.extra_collections_1 %}
    {% assign list2 = block.settings.extra_collections_2 %}
    {% assign list3 = block.settings.extra_collections_3 %}
    {% assign count1 = list1.size %}
    {% assign count2 = list2.size %}
    {% assign count3 = list3.size %}

    {% capture pairs_string %}
      {% for collection in list1 %}
        {% assign safe_title = collection.title | replace: '::', ' ' | replace: '|', ' ' %}
        {{ safe_title }}::{{ collection.handle }}|
      {% endfor %}
      {% for collection in list2 %}
        {% assign safe_title = collection.title | replace: '::', ' ' | replace: '|', ' ' %}
        {{ safe_title }}::{{ collection.handle }}|
      {% endfor %}
      {% for collection in list3 %}
        {% assign safe_title = collection.title | replace: '::', ' ' | replace: '|', ' ' %}
        {{ safe_title }}::{{ collection.handle }}|
      {% endfor %}
    {% endcapture %}

    {% assign pairs_string = pairs_string | strip_newlines | strip %}
    {% assign raw_pairs = pairs_string | split: '|' %}
    {% assign sorted_pairs = raw_pairs | uniq | sort %}

    {% assign total_shown = 0 %}
    {% for pair in sorted_pairs %}
      {% assign pair_trimmed = pair | strip %}
      {% unless pair_trimmed == blank %}
        {% assign total_shown = total_shown | plus: 1 %}
      {% endunless %}
    {% endfor %}

    {% if block.settings.show_debug %}
      <div class="ai-brands-debug-{{ ai_gen_id }}">
        DEBUG → Part 1: {{ count1 }} | Part 2: {{ count2 }} | Part 3: {{ count3 }} | Total shown (after dedupe): {{ total_shown }}
      </div>
    {% endif %}

    {% if total_shown > 0 %}
      {% if block.settings.show_search %}
        <div class="ai-brands-search-wrapper-{{ ai_gen_id }}">
          <input
            type="text"
            class="ai-brands-search-input-{{ ai_gen_id }}"
            placeholder="{{ block.settings.search_placeholder }}"
            aria-label="Search brands"
            data-search-input
          >
          <svg class="ai-brands-search-icon-{{ ai_gen_id }}" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="8.5" cy="8.5" r="6" stroke="currentColor" stroke-width="2"/>
            <path d="M13 13L17 17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </div>
      {% endif %}

      {% assign letters_all = "ABCDEFGHIJKLMNOPQRSTUVWXYZ" | split: "" %}

      {% if block.settings.show_az_nav %}
        <nav class="ai-brands-az-nav-{{ ai_gen_id }}" aria-label="Alphabetical navigation" data-az-nav>
          {% for letter_char in letters_all %}
            <a
              href="#letter-{{ letter_char | downcase }}"
              class="ai-brands-az-letter-{{ ai_gen_id }}"
              data-letter="{{ letter_char }}"
              aria-label="Jump to brands starting with {{ letter_char }}"
            >
              {{ letter_char }}
            </a>
          {% endfor %}
        </nav>
      {% endif %}

      <div class="ai-brands-content-{{ ai_gen_id }}" data-brands-content>
        {% comment %} Each letter section fully self-contained in one loop pass {% endcomment %}
        {% for letter_char in letters_all %}
          {% assign letter_has_items = false %}
          {% for pair in sorted_pairs %}
            {% assign pair_trimmed = pair | strip %}
            {% unless pair_trimmed == blank %}
              {% assign pair_parts = pair_trimmed | split: '::' %}
              {% assign pair_title = pair_parts[0] %}
              {% assign first_char = pair_title | slice: 0 | upcase %}
              {% if first_char == letter_char %}
                {% assign letter_has_items = true %}
              {% endif %}
            {% endunless %}
          {% endfor %}

          {% if letter_has_items %}
            <div class="ai-brands-alphabet-section-{{ ai_gen_id }}" data-letter-section="{{ letter_char }}">
              <h2 class="ai-brands-alphabet-heading-{{ ai_gen_id }}" id="letter-{{ letter_char | downcase }}">{{ letter_char }}</h2>
              <div class="ai-brands-grid-{{ ai_gen_id }}">
                {% for pair in sorted_pairs %}
                  {% assign pair_trimmed = pair | strip %}
                  {% unless pair_trimmed == blank %}
                    {% assign pair_parts = pair_trimmed | split: '::' %}
                    {% assign pair_title = pair_parts[0] %}
                    {% assign pair_handle = pair_parts[1] %}
                    {% assign first_char = pair_title | slice: 0 | upcase %}
                    {% if first_char == letter_char %}
                      {% assign collection = collections[pair_handle] %}
                      <a href="{{ collection.url }}" class="ai-brands-card-{{ ai_gen_id }}" data-brand-card data-brand-name="{{ collection.title }}">
                        <div class="ai-brands-card-image-wrapper-{{ ai_gen_id }}">
                          {% if collection.featured_image %}
                            <img
                              src="{{ collection.featured_image | image_url: width: 400 }}"
                              alt="{{ collection.featured_image.alt | default: collection.title | escape }}"
                              class="ai-brands-card-image-{{ ai_gen_id }}"
                              loading="lazy"
                              width="400"
                              height="400"
                            >
                          {% else %}
                            <div class="ai-brands-card-placeholder-{{ ai_gen_id }}">
                              {{ 'collection-1' | placeholder_svg_tag }}
                            </div>
                          {% endif %}
                        </div>
                        <div class="ai-brands-card-content-{{ ai_gen_id }}">
                          <h3 class="ai-brands-card-title-{{ ai_gen_id }}">{{ collection.title }}</h3>
                        </div>
                      </a>
                    {% endif %}
                  {% endunless %}
                {% endfor %}
              </div>
            </div>
          {% endif %}
        {% endfor %}

        {% comment %} Titles not starting with A-Z go under '#' {% endcomment %}
        {% assign hash_has_items = false %}
        {% for pair in sorted_pairs %}
          {% assign pair_trimmed = pair | strip %}
          {% unless pair_trimmed == blank %}
            {% assign pair_parts = pair_trimmed | split: '::' %}
            {% assign pair_title = pair_parts[0] %}
            {% assign first_char = pair_title | slice: 0 | upcase %}
            {% assign is_letter_match = letters_all | where: first_char %}
            {% if is_letter_match.size == 0 %}
              {% assign hash_has_items = true %}
            {% endif %}
          {% endunless %}
        {% endfor %}

        {% if hash_has_items %}
          <div class="ai-brands-alphabet-section-{{ ai_gen_id }}" data-letter-section="#">
            <h2 class="ai-brands-alphabet-heading-{{ ai_gen_id }}" id="letter-hash">#</h2>
            <div class="ai-brands-grid-{{ ai_gen_id }}">
              {% for pair in sorted_pairs %}
                {% assign pair_trimmed = pair | strip %}
                {% unless pair_trimmed == blank %}
                  {% assign pair_parts = pair_trimmed | split: '::' %}
                  {% assign pair_title = pair_parts[0] %}
                  {% assign pair_handle = pair_parts[1] %}
                  {% assign first_char = pair_title | slice: 0 | upcase %}
                  {% assign is_letter_match = letters_all | where: first_char %}
                  {% if is_letter_match.size == 0 %}
                    {% assign collection = collections[pair_handle] %}
                    <a href="{{ collection.url }}" class="ai-brands-card-{{ ai_gen_id }}" data-brand-card data-brand-name="{{ collection.title }}">
                      <div class="ai-brands-card-image-wrapper-{{ ai_gen_id }}">
                        {% if collection.featured_image %}
                          <img
                            src="{{ collection.featured_image | image_url: width: 400 }}"
                            alt="{{ collection.featured_image.alt | default: collection.title | escape }}"
                            class="ai-brands-card-image-{{ ai_gen_id }}"
                            loading="lazy"
                            width="400"
                            height="400"
                          >
                        {% else %}
                          <div class="ai-brands-card-placeholder-{{ ai_gen_id }}">
                            {{ 'collection-1' | placeholder_svg_tag }}
                          </div>
                        {% endif %}
                      </div>
                      <div class="ai-brands-card-content-{{ ai_gen_id }}">
                        <h3 class="ai-brands-card-title-{{ ai_gen_id }}">{{ collection.title }}</h3>
                      </div>
                    </a>
                  {% endif %}
                {% endunless %}
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </div>
    {% else %}
      <div class="ai-brands-empty-state-{{ ai_gen_id }}">
        Please select brand collections in Part 1, 2, or 3 below.
      </div>
    {% endif %}
  </div>
</all-brands-page-{{ ai_gen_id }}>

<script>
  (function() {
    class AllBrandsPage{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.searchInput = this.querySelector('[data-search-input]');
        this.brandsContent = this.querySelector('[data-brands-content]');
        this.azNav = this.querySelector('[data-az-nav]');
        this.azLetters = this.querySelectorAll('.ai-brands-az-letter-{{ ai_gen_id }}');
        this.allCards = this.querySelectorAll('[data-brand-card]');
        this.allSections = this.querySelectorAll('[data-letter-section]');
        this.searchTimeout = null;
      }

      connectedCallback() {
        this.setupEventListeners();
        this.updateAZNavigation();
      }

      setupEventListeners() {
        if (this.searchInput) {
          this.searchInput.addEventListener('input', (e) => {
            clearTimeout(this.searchTimeout);
            this.searchTimeout = setTimeout(() => {
              this.filterBrands(e.target.value);
            }, 300);
          });
        }

        this.azLetters.forEach(letter => {
          letter.addEventListener('click', (e) => {
            e.preventDefault();
            const targetLetter = letter.getAttribute('data-letter');
            const targetSection = this.querySelector(`#letter-${targetLetter.toLowerCase()}`);
            if (targetSection && !letter.classList.contains('disabled')) {
              targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          });
        });
      }

      filterBrands(searchTerm) {
        const term = searchTerm.toLowerCase().trim();

        if (!term) {
          this.allCards.forEach(card => card.style.display = '');
          this.allSections.forEach(section => section.style.display = '');
          this.updateAZNavigation();
          return;
        }

        let hasResults = false;
        const visibleLetters = new Set();

        this.allCards.forEach(card => {
          const brandName = card.getAttribute('data-brand-name').toLowerCase();
          if (brandName.includes(term)) {
            card.style.display = '';
            hasResults = true;
            const section = card.closest('[data-letter-section]');
            if (section) {
              const letter = section.getAttribute('data-letter-section');
              visibleLetters.add(letter);
            }
          } else {
            card.style.display = 'none';
          }
        });

        this.allSections.forEach(section => {
          const visibleCardsInSection = Array.from(section.querySelectorAll('[data-brand-card]')).filter(
            card => card.style.display !== 'none'
          );

          if (visibleCardsInSection.length > 0) {
            section.style.display = '';
          } else {
            section.style.display = 'none';
          }
        });

        if (!hasResults) {
          const noResults = this.brandsContent.querySelector('.ai-brands-no-results-{{ ai_gen_id }}');
          if (!noResults) {
            const div = document.createElement('div');
            div.className = 'ai-brands-no-results-{{ ai_gen_id }}';
            div.textContent = 'No brands found matching your search.';
            this.brandsContent.appendChild(div);
          }
        } else {
          const noResults = this.brandsContent.querySelector('.ai-brands-no-results-{{ ai_gen_id }}');
          if (noResults) {
            noResults.remove();
          }
        }

        this.updateAZNavigation(Array.from(visibleLetters));
      }

      updateAZNavigation(activeLetters = null) {
        if (!this.azNav) return;

        const availableLetters = activeLetters || Array.from(this.allSections).map(
          section => section.getAttribute('data-letter-section')
        );

        this.azLetters.forEach(letterEl => {
          const letter = letterEl.getAttribute('data-letter');
          if (availableLetters.includes(letter)) {
            letterEl.classList.remove('disabled');
          } else {
            letterEl.classList.add('disabled');
          }
        });
      }
    }

    customElements.define('all-brands-page-{{ ai_gen_id }}', AllBrandsPage{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "New brand section",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Brand collections"
    },
    {
      "type": "paragraph",
      "content": "Select up to 50 collections per part below (Shopify's picker limit). Spread your brands across Part 1, 2, and 3 for up to 150 total. Avoid selecting the same collection in more than one part — duplicates are automatically removed from the display either way."
    },
    {
      "type": "collection_list",
      "id": "extra_collections_1",
      "label": "Brand collections — Part 1"
    },
    {
      "type": "collection_list",
      "id": "extra_collections_2",
      "label": "Brand collections — Part 2"
    },
    {
      "type": "collection_list",
      "id": "extra_collections_3",
      "label": "Brand collections — Part 3"
    },
    {
      "type": "checkbox",
      "id": "show_debug",
      "label": "Show debug counter (temporary — turn off after testing)",
      "default": false
    },
    {
      "type": "header",
      "content": "Page content"
    },
    {
      "type": "text",
      "id": "page_title",
      "label": "Page title",
      "default": "All Brands"
    },
    {
      "type": "text",
      "id": "page_subtitle",
      "label": "Page subtitle",
      "default": "Explore our complete collection of brands"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 48
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtitle size",
      "default": 18
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search bar",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search brands..."
    },
    {
      "type": "color",
      "id": "search_bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "search_border_color",
      "label": "Border",
      "default": "#e0e0e0"
    },
    {
      "type": "color",
      "id": "search_focus_color",
      "label": "Focus border",
      "default": "#00a341"
    },
    {
      "type": "range",
      "id": "search_border_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "A-Z navigation"
    },
    {
