{% doc %}
  @prompt
    Create a Wholesale Contact / Registration form for my Shopify store.
    
    Form purpose:
    Customers will apply for a wholesale account. After submission, I will manually review and approve them.
    
    Form fields (same order and structure as a professional B2B wholesale form):
    
    1. Company Name (text, required)
    2. First Name (text, required)
    3. Last Name (text, required)
    
    Section heading: "Company Shipping Address"
    
    4. Country (dropdown, required)
    5. Shipping First Name (text, required)
    6. Shipping Last Name (text, required)
    7. Company / Attention (text)
    8. Address (text, required)
    9. Apartment, suite, etc. (text)
    10. City (text, required)
    11. Postcode / ZIP (text, required)
    12. Phone number (country selector + phone input, required)
    
    Next section:
    
    13. Company Tax ID / VAT Number (text)
    14. Business Website (URL)
    15. Email Address (email, required)
    16. Secondary Phone Number (country selector + phone input)
    
    Submit button text: "Submit"
    
    Form behavior:
    - Use Shopify contact form functionality
    - Send submission to store admin email
    - Save data in Shopify admin (Inbox / Contact messages)
    - Add tag "wholesale-request" to the contact/customer
    - Show a success message after submission: 
      "Thank you for applying. We will review your request and contact you shortly."
    
    Design requirements:
    - Clean, modern, professional B2B style
    - Mobile responsive
    - Similar layout to a wholesale registration form
    - Proper spacing and labels
    If the email already exists as a customer, attach the submission to that customer profile.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-wholesale-form-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.form_padding }}px;
    background-color: {{ block.settings.form_background }};
    border-radius: {{ block.settings.form_border_radius }}px;
  }

  .ai-wholesale-form__container-{{ ai_gen_id }} {
    max-width: 800px;
    margin: 0 auto;
  }

  .ai-wholesale-form__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.spacing_between_fields }}px;
    text-align: {{ block.settings.heading_alignment }};
  }

  .ai-wholesale-form__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.spacing_between_fields | times: 2 }}px;
    text-align: {{ block.settings.heading_alignment }};
  }

  .ai-wholesale-form__section-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: {{ block.settings.spacing_between_fields | times: 2 }}px 0 {{ block.settings.spacing_between_fields }}px;
    padding-bottom: {{ block.settings.spacing_between_fields | divided_by: 2 }}px;
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-wholesale-form__field-group-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.spacing_between_fields }}px;
  }

  .ai-wholesale-form__row-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.spacing_between_fields }}px;
  }

  .ai-wholesale-form__label-{{ ai_gen_id }} {
    display: block;
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.text_color }};
    margin-bottom: 8px;
    font-weight: 500;
  }

  .ai-wholesale-form__required-{{ ai_gen_id }} {
    color: {{ block.settings.required_color }};
    margin-left: 4px;
  }

  .ai-wholesale-form__input-{{ ai_gen_id }},
  .ai-wholesale-form__select-{{ ai_gen_id }},
  .ai-wholesale-form__textarea-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    font-size: {{ block.settings.input_size }}px;
    color: {{ block.settings.text_color }};
    background-color: {{ block.settings.input_background }};
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    transition: border-color 0.2s ease;
  }

  .ai-wholesale-form__input-{{ ai_gen_id }}:focus,
  .ai-wholesale-form__select-{{ ai_gen_id }}:focus,
  .ai-wholesale-form__textarea-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.input_focus_border_color }};
  }

  .ai-wholesale-form__phone-wrapper-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: {{ block.settings.spacing_between_fields | divided_by: 2 }}px;
  }

  .ai-wholesale-form__button-{{ ai_gen_id }} {
    width: 100%;
    padding: 16px 32px;
    font-size: {{ block.settings.button_size }}px;
    font-weight: 600;
    color: {{ block.settings.button_text_color }};
    background-color: {{ block.settings.button_background }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    transition: background-color 0.2s ease;
    margin-top: {{ block.settings.spacing_between_fields }}px;
  }

  .ai-wholesale-form__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-wholesale-form__success-{{ ai_gen_id }} {
    padding: 16px;
    background-color: {{ block.settings.success_background }};
    color: {{ block.settings.success_text_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-top: {{ block.settings.spacing_between_fields }}px;
    text-align: center;
  }

  .ai-wholesale-form__error-{{ ai_gen_id }} {
    padding: 16px;
    background-color: {{ block.settings.error_background }};
    color: {{ block.settings.error_text_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-top: {{ block.settings.spacing_between_fields }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-wholesale-form__row-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-wholesale-form-{{ ai_gen_id }} {
      padding: {{ block.settings.form_padding | divided_by: 2 }}px;
    }

    .ai-wholesale-form__heading-{{ ai_gen_id }} {
