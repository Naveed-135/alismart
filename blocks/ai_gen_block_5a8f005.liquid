<script>
  (function() {
    class WholesaleForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const form = this.querySelector('form');
        if (form) {
          form.addEventListener('submit', this.handleSubmit.bind(this));
        }
      }

      handleSubmit(event) {
        const requiredFields = this.querySelectorAll('[required]');
        let isValid = true;

        requiredFields.forEach(field => {
          if (!field.value.trim()) {
            isValid = false;
            field.style.borderColor = '{{ block.settings.error_text_color }}';
          } else {
            field.style.borderColor = '{{ block.settings.input_border_color }}';
          }
        });

        if (!isValid) {
          event.preventDefault();
        }
      }
    }

    customElements.define('wholesale-form-{{ ai_gen_id }}', WholesaleForm{{ ai_gen_id }});
  })();
</script>

