{% doc %}
  @prompt
    Create a modern 3-column promotional banner section for a Shopify store, similar to the provided design.
    
    The section should display three large image cards side-by-side, each with text and a call-to-action button overlaid on the image.
    
    Section layout & structure:
    
    Three equal-width image blocks in one row on desktop
    
    Stack into one or two columns on tablet and mobile
    
    Each image acts as a promotional card
    
    Content per image card:
    
    Background image uploadable from the Shopify theme editor
    
    Small optional label or brand name at the top
    
    Large bold heading text
    
    Primary CTA button (Shop Now / Apply Now)
    
    All text centered or aligned consistently
    
    Example content:
    
    Helly Hansen
    Heading: Save Today
    Button: Shop Now
    
    Workwear For All
    Heading: Women’s Range
    Button: Shop Now
    
    Open A Trade Account
    Button: Apply Now
    
    Design & styling:
    
    Full-height background images with object-fit: cover
    
    Dark overlay or gradient for text readability
    
    White text over images
    
    Clean, bold typography
    
    Buttons in solid white with dark text
    
    Subtle hover effect on images and buttons
    
    Functionality:
    
    Each image card and button should link to a selected collection, page, or URL
    
    Content (image, text, button label, link) fully editable from Shopify Theme Customizer
    
    Technical requirements:
    
    Built using Shopify Liquid, HTML, and CSS
    
    Implemented as a reusable custom section
    
    Fully responsive and mobile-friendly
    
    No third-party apps required
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-promo-banner-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 0;
  }

  .ai-promo-banner__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.gap_desktop }}px;
    width: 100%;
  }

  .ai-promo-banner__card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    min-height: {{ block.settings.card_height_desktop }}px;
    transition: transform 0.3s ease;
  }

  .ai-promo-banner__card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-promo-banner__image-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-promo-banner__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .ai-promo-banner__card-{{ ai_gen_id }}:hover .ai-promo-banner__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-promo-banner__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #e5e5e5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-promo-banner__placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    opacity: 0.3;
  }

  .ai-promo-banner__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, {{ block.settings.overlay_opacity_top | divided_by: 100.0 }}),
      rgba(0, 0, 0, {{ block.settings.overlay_opacity_bottom | divided_by: 100.0 }})
    );
  }

  .ai-promo-banner__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.content_vertical_alignment }};
    align-items: {{ block.settings.content_horizontal_alignment }};
    height: 100%;
    padding: {{ block.settings.content_padding }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-promo-banner__label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_font_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-promo-banner__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_font_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    line-height: 1.2;
  }

  .ai-promo-banner__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-promo-banner__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
  }

  .ai-promo-banner__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
    z-index: 3;
  }

  @media screen and (max-width: 989px) {
    .ai-promo-banner__container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
      gap: {{ block.settings.gap_tablet }}px;
    }

    .ai-promo-banner__card-{{ ai_gen_id }} {
      min-height: {{ block.settings.card_height_tablet }}px;
    }

    .ai-promo-banner__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_font_size }}px * 0.8);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-promo-banner__container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.gap_mobile }}px;
    }

    .ai-promo-banner__card-{{ ai_gen_id }} {
      min-height: {{ block.settings.card_height_mobile }}px;
    }

    .ai-promo-banner__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_font_size }}px * 0.7);
    }

    .ai-promo-banner__label-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.label_font_size }}px * 0.9);
    }

    .ai-promo-banner__button-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.button_font_size }}px * 0.9);
      padding: {{ block.settings.button_padding_vertical | times: 0.8 }}px {{ block.settings.button_padding_horizontal | times: 0.8 }}px;
    }

    .ai-promo-banner__content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding | times: 0.7 }}px;
    }
  }
{% endstyle %}
<div class="section">
<promo-banner-{{ ai_gen_id }} class="ai-promo-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-promo-banner__container-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign label_key = 'label_' | append: i
        assign heading_key = 'heading_' | append: i
        assign button_text_key = 'button_text_' | append: i
        assign button_link_key = 'button_link_' | append: i

        assign card_image = block.settings[image_key]
        assign card_label = block.settings[label_key]
        assign card_heading = block.settings[heading_key]
        assign card_button_text = block.settings[button_text_key]
        assign card_button_link = block.settings[button_link_key]
      %}

      <div class="ai-promo-banner__card-{{ ai_gen_id }}">
        <div class="ai-promo-banner__image-wrapper-{{ ai_gen_id }}">
          {% if card_image %}
            <img
              src="{{ card_image | image_url: width: 800 }}"
              srcset="{{ card_image | image_url: width: 400 }} 400w,
                      {{ card_image | image_url: width: 600 }} 600w,
                      {{ card_image | image_url: width: 800 }} 800w,
                      {{ card_image | image_url: width: 1000 }} 1000w"
              sizes="(max-width: 749px) 100vw, (max-width: 989px) 50vw, 33vw"
              alt="{{ card_image.alt | escape }}"
              class="ai-promo-banner__image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ card_image.width }}"
              height="{{ card_image.height }}"
            >
          {% else %}
            <div class="ai-promo-banner__placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        <div class="ai-promo-banner__overlay-{{ ai_gen_id }}"></div>

        <div class="ai-promo-banner__content-{{ ai_gen_id }}">
          {% if card_label != blank %}
            <div class="ai-promo-banner__label-{{ ai_gen_id }}">{{ card_label }}</div>
          {% endif %}

          {% if card_heading != blank %}
            <h3 class="ai-promo-banner__heading-{{ ai_gen_id }}">{{ card_heading }}</h3>
          {% endif %}

          {% if card_button_text != blank %}
            <a
              href="{{ card_button_link | default: '#' }}"
              class="ai-promo-banner__button-{{ ai_gen_id }}"
            >
              {{ card_button_text }}
            </a>
          {% endif %}
        </div>

        {% if card_image == blank %}
          <div class="ai-promo-banner__empty-state-{{ ai_gen_id }}">
            Add an image for card {{ i }}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</promo-banner-{{ ai_gen_id }}>
</div>
<script>
  (function() {
    class PromoBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.cards = this.querySelectorAll('.ai-promo-banner__card-{{ ai_gen_id }}');
        this.setupAccessibility();
      }

      setupAccessibility() {
        this.cards.forEach((card) => {
          const link = card.querySelector('.ai-promo-banner__button-{{ ai_gen_id }}');
          if (link) {
            card.style.cursor = 'pointer';
            card.addEventListener('click', (e) => {
              if (e.target.tagName !== 'A') {
                link.click();
              }
            });
          }
        });
      }
    }

    customElements.define('promo-banner-{{ ai_gen_id }}', PromoBanner{{ ai_gen_id }});
  })();
</script>

