      "label": "Border radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "A-Z navigation"
    },
    {
      "type": "checkbox",
      "id": "show_az_nav",
      "label": "Show A-Z navigation",
      "default": true
    },
    {
      "type": "color",
      "id": "az_nav_bg_color",
      "label": "Navigation background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "az_letter_bg",
      "label": "Letter background",
      "default": "#f0f0f0"
    },
    {
      "type": "color",
      "id": "az_letter_color",
      "label": "Letter text",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "az_letter_hover_bg",
      "label": "Letter hover background",
      "default": "#00a341"
    },
    {
