{% doc %}
  @prompt
    Create a modern “All Brands” page for a Shopify store using Collections as Brands (not vendors).
    
    The page should support hundreds or thousands of brand collections (1000+) and automatically display only the collections that actually exist.
    
    🔍 Search Functionality (REQUIRED)
    
    Add a search bar at the top
    
    Users can search brands by collection name
    
    Search should work instantly as the user types
    
    Only matching brand collections should be shown
    
    🔤 Alphabetical Navigation (A–Z)
    
    Add an A–Z navigation bar at the top
    
    Each letter should scroll to its section
    
    Show ONLY those letters that have collections
    
    Hide letters that have no collections
    
    📌 Page Structure & Layout
    
    Each alphabet letter displayed as a bold heading
    
    Under each letter, show all brand collections starting with that letter
    
    Each brand should include:
    
    Collection image (featured image)
    
    Collection title (brand name)
    
    Clickable link to the collection page
    
    Display brands in a clean grid layout
    
    Maintain proper spacing and alignment
    
    Fully responsive and mobile-friendly
    
    🧠 Data & Logic
    
    Automatically fetch all collections
    
    Treat each collection as a brand
    
    Sort collections alphabetically (A–Z)
    
    Group collections by their first letter
    
    Only show letters that contain collections
    
    Support large stores with 1000+ collections
    
    🎨 Design Style
    
    Clean, minimal, professional ecommerce layout
    
    White background
    
    Clear typography
    
    Easy-to-scan alphabetical sections
    
    Subtle hover effects on brand cards
    
    ⚙️ Technical Requirements
    
    Built for Shopify
    
    Use Liquid + HTML + CSS
    
    Add JavaScript only for search filtering
    
    Can be added as:
    
    Custom page template
    
    OR Shopify section
    
    SEO-friendly structure using proper heading tags
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-brands-page-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-brands-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-brands-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-brands-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px;
    font-weight: 700;
  }

  .ai-brands-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-brands-search-wrapper-{{ ai_gen_id }} {
    max-width: 600px;
    margin: 0 auto 40px;
    position: relative;
  }

  .ai-brands-search-input-{{ ai_gen_id }} {
    width: 100%;
    padding: 16px 50px 16px 20px;
    font-size: 16px;
    border: 2px solid {{ block.settings.search_border_color }};
    border-radius: {{ block.settings.search_border_radius }}px;
    background-color: {{ block.settings.search_bg_color }};
    color: {{ block.settings.text_color }};
    transition: border-color 0.3s ease;
  }

  .ai-brands-search-input-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.search_focus_color }};
  }

  .ai-brands-search-icon-{{ ai_gen_id }} {
    position: absolute;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: {{ block.settings.text_color }};
    opacity: 0.5;
    pointer-events: none;
  }

  .ai-brands-az-nav-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: 50px;
    padding: 20px;
    background-color: {{ block.settings.az_nav_bg_color }};
    border-radius: {{ block.settings.az_nav_border_radius }}px;
  }

  .ai-brands-az-letter-{{ ai_gen_id }} {
    min-width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.az_letter_color }};
    background-color: {{ block.settings.az_letter_bg }};
    border-radius: {{ block.settings.az_letter_border_radius }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    border: 2px solid transparent;
  }

  .ai-brands-az-letter-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.az_letter_hover_bg }};
    color: {{ block.settings.az_letter_hover_color }};
    transform: translateY(-2px);
  }

  .ai-brands-az-letter-{{ ai_gen_id }}.disabled {
    opacity: 0.3;
    cursor: not-allowed;
    pointer-events: none;
  }

  .ai-brands-alphabet-section-{{ ai_gen_id }} {
    margin-bottom: 60px;
  }

  .ai-brands-alphabet-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.alphabet_heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.alphabet_heading_color }};
    margin: 0 0 24px;
    padding-bottom: 12px;
    border-bottom: 3px solid {{ block.settings.alphabet_border_color }};
    scroll-margin-top: 100px;
  }

  .ai-brands-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-brands-card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    background-color: {{ block.settings.card_bg_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: all 0.3s ease;
    text-decoration: none;
    border: 1px solid {{ block.settings.card_border_color }};
  }

  .ai-brands-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .ai-brands-card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-top: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background-color: {{ block.settings.image_placeholder_bg }};
  }

  .ai-brands-card-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-brands-card-{{ ai_gen_id }}:hover .ai-brands-card-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-brands-card-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.image_placeholder_bg }};
  }

  .ai-brands-card-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-brands-card-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    text-align: center;
  }

  .ai-brands-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.card_title_color }};
    margin: 0;
  }

  .ai-brands-no-results-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.text_color }};
    font-size: 18px;
  }

  .ai-brands-loading-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px;
    color: {{ block.settings.text_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-brands-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-brands-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-brands-alphabet-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.alphabet_heading_size }}px * 0.85);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-brands-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-brands-az-nav-{{ ai_gen_id }} {
      gap: 6px;
      padding: 15px;
    }

    .ai-brands-az-letter-{{ ai_gen_id }} {
      min-width: 36px;
      height: 36px;
      font-size: 14px;
    }

    .ai-brands-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.7);
    }

    .ai-brands-alphabet-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.alphabet_heading_size }}px * 0.75);
    }

    .ai-brands-card-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.card_title_size }}px * 0.9);
    }
  }
{% endstyle %}

<all-brands-page-{{ ai_gen_id }} class="ai-brands-page-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-brands-container-{{ ai_gen_id }}">
    <div class="ai-brands-header-{{ ai_gen_id }}">
      {% if block.settings.page_title != blank %}
        <h1 class="ai-brands-title-{{ ai_gen_id }}">{{ block.settings.page_title }}</h1>
      {% endif %}
      {% if block.settings.page_subtitle != blank %}
        <p class="ai-brands-subtitle-{{ ai_gen_id }}">{{ block.settings.page_subtitle }}</p>
      {% endif %}
    </div>

    {% if block.settings.show_search %}
      <div class="ai-brands-search-wrapper-{{ ai_gen_id }}">
        <input
          type="text"
          class="ai-brands-search-input-{{ ai_gen_id }}"
          placeholder="{{ block.settings.search_placeholder }}"
          aria-label="Search brands"
          data-search-input
        >
        <svg class="ai-brands-search-icon-{{ ai_gen_id }}" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="8.5" cy="8.5" r="6" stroke="currentColor" stroke-width="2"/>
          <path d="M13 13L17 17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>
    {% endif %}

    {% if block.settings.show_az_nav %}
      <nav class="ai-brands-az-nav-{{ ai_gen_id }}" aria-label="Alphabetical navigation">
        {% for i in (65..90) %}
          {% assign letter = i | minus: 65 | plus: 97 | modulo: 26 | plus: 65 %}
          {% assign letter_char = '' %}
          {% case letter %}
            {% when 65 %}{% assign letter_char = 'A' %}
            {% when 66 %}{% assign letter_char = 'B' %}
            {% when 67 %}{% assign letter_char = 'C' %}
            {% when 68 %}{% assign letter_char = 'D' %}
            {% when 69 %}{% assign letter_char = 'E' %}
            {% when 70 %}{% assign letter_char = 'F' %}
            {% when 71 %}{% assign letter_char = 'G' %}
            {% when 72 %}{% assign letter_char = 'H' %}
            {% when 73 %}{% assign letter_char = 'I' %}
            {% when 74 %}{% assign letter_char = 'J' %}
            {% when 75 %}{% assign letter_char = 'K' %}
            {% when 76 %}{% assign letter_char = 'L' %}
            {% when 77 %}{% assign letter_char = 'M' %}
            {% when 78 %}{% assign letter_char = 'N' %}
            {% when 79 %}{% assign letter_char = 'O' %}
            {% when 80 %}{% assign letter_char = 'P' %}
            {% when 81 %}{% assign letter_char = 'Q' %}
            {% when 82 %}{% assign letter_char = 'R' %}
            {% when 83 %}{% assign letter_char = 'S' %}
            {% when 84 %}{% assign letter_char = 'T' %}
            {% when 85 %}{% assign letter_char = 'U' %}
            {% when 86 %}{% assign letter_char = 'V' %}
            {% when 87 %}{% assign letter_char = 'W' %}
            {% when 88 %}{% assign letter_char = 'X' %}
            {% when 89 %}{% assign letter_char = 'Y' %}
            {% when 90 %}{% assign letter_char = 'Z' %}
          {% endcase %}
          <a
            href="#letter-{{ letter_char | downcase }}"
            class="ai-brands-az-letter-{{ ai_gen_id }}"
            data-letter="{{ letter_char }}"
            aria-label="Jump to brands starting with {{ letter_char }}"
          >
            {{ letter_char }}
          </a>
        {% endfor %}
      </nav>
    {% endif %}

    <div class="ai-brands-content-{{ ai_gen_id }}" data-brands-content>
      <div class="ai-brands-loading-{{ ai_gen_id }}" data-loading>Loading brands...</div>
    </div>
  </div>
</all-brands-page-{{ ai_gen_id }}>

<script>
  (function() {
    class AllBrandsPage{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.collections = [];
        this.groupedCollections = {};
        this.searchInput = this.querySelector('[data-search-input]');
        this.brandsContent = this.querySelector('[data-brands-content]');
        this.loadingEl = this.querySelector('[data-loading]');
        this.azLetters = this.querySelectorAll('.ai-brands-az-letter-{{ ai_gen_id }}');
        this.searchTimeout = null;
      }

      connectedCallback() {
        this.fetchCollections();
        this.setupEventListeners();
      }

      setupEventListeners() {
        if (this.searchInput) {
          this.searchInput.addEventListener('input', (e) => {
            clearTimeout(this.searchTimeout);
            this.searchTimeout = setTimeout(() => {
              this.filterBrands(e.target.value);
            }, 300);
          });
        }

        this.azLetters.forEach(letter => {
          letter.addEventListener('click', (e) => {
            e.preventDefault();
            const targetLetter = letter.getAttribute('data-letter');
            const targetSection = this.querySelector(`#letter-${targetLetter.toLowerCase()}`);
            if (targetSection && !letter.classList.contains('disabled')) {
              targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          });
        });
      }

      async fetchCollections() {
        try {
          let allCollections = [];
          let page = 1;
          let hasMore = true;

          while (hasMore) {
            const response = await fetch(`/collections.json?page=${page}&limit=250`);
            const data = await response.json();
            
            if (data.collections && data.collections.length > 0) {
              allCollections = allCollections.concat(data.collections);
              page++;
              if (data.collections.length < 250) {
                hasMore = false;
              }
            } else {
              hasMore = false;
            }
          }

          this.collections = allCollections.sort((a, b) => 
            a.title.localeCompare(b.title, undefined, { sensitivity: 'base' })
          );

          this.groupCollectionsByLetter();
          this.renderBrands();
          this.updateAZNavigation();
        } catch (error) {
          console.error('Error fetching collections:', error);
          this.brandsContent.innerHTML = '<div class="ai-brands-no-results-{{ ai_gen_id }}">Unable to load brands. Please try again later.</div>';
        }
      }

      groupCollectionsByLetter() {
        this.groupedCollections = {};
        
        this.collections.forEach(collection => {
          const firstLetter = collection.title.charAt(0).toUpperCase();
          const letter = firstLetter.match(/[A-Z]/) ? firstLetter : '#';
          
          if (!this.groupedCollections[letter]) {
            this.groupedCollections[letter] = [];
          }
          this.groupedCollections[letter].push(collection);
        });
      }

      renderBrands(filteredCollections = null) {
        const collectionsToRender = filteredCollections || this.groupedCollections;
        
        if (this.loadingEl) {
          this.loadingEl.style.display = 'none';
        }

        if (Object.keys(collectionsToRender).length === 0) {
          this.brandsContent.innerHTML = '<div class="ai-brands-no-results-{{ ai_gen_id }}">No brands found matching your search.</div>';
          return;
        }

        let html = '';
        const letters = Object.keys(collectionsToRender).sort();

        letters.forEach(letter => {
          const collections = collectionsToRender[letter];
          
          html += `
            <div class="ai-brands-alphabet-section-{{ ai_gen_id }}" data-letter-section="${letter}">
              <h2 class="ai-brands-alphabet-heading-{{ ai_gen_id }}" id="letter-${letter.toLowerCase()}">${letter}</h2>
              <div class="ai-brands-grid-{{ ai_gen_id }}">
          `;

          collections.forEach(collection => {
            const imageUrl = collection.image ? collection.image.src : '';
            const imageAlt = collection.image ? collection.image.alt || collection.title : collection.title;
            
            html += `
              <a href="/collections/${collection.handle}" class="ai-brands-card-{{ ai_gen_id }}" data-brand-card>
                <div class="ai-brands-card-image-wrapper-{{ ai_gen_id }}">
            `;

            if (imageUrl) {
              html += `
                <img
                  src="${imageUrl}"
                  alt="${this.escapeHtml(imageAlt)}"
                  class="ai-brands-card-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="400"
                  height="400"
                >
              `;
            } else {
              html += `
                <div class="ai-brands-card-placeholder-{{ ai_gen_id }}">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 525.5 525.5">
                    <path d="M324.5 212.7H203c-1.6 0-2.8 1.3-2.8 2.8V308c0 1.6 1.3 2.8 2.8 2.8h121.6c1.6 0 2.8-1.3 2.8-2.8v-92.5c0-1.6-1.3-2.8-2.9-2.8zm1.1 95.3c0 .6-.5 1.1-1.1 1.1H203c-.6 0-1.1-.5-1.1-1.1v-92.5c0-.6.5-1.1 1.1-1.1h121.6c.6 0 1.1.5 1.1 1.1V308z"/>
                    <path d="M210.4 299.5H240v.1s.1 0 .2-.1h75.2v-76.2h-105v76.2zm1.8-7.2l20-20c1.6-1.6 3.8-2.5 6.1-2.5s4.5.9 6.1 2.5l1.5 1.5 16.8 16.8c-12.9 3.3-20.7 6.3-22.8 7.2h-27.7v-5.5zm101.5-10.1c-20.1 1.7-36.7 4.8-49.1 7.9l-16.9-16.9 26.3-26.3c1.6-1.6 3.8-2.5 6.1-2.5s4.5.9 6.1 2.5l27.5 27.5v7.8zm-68.9 15.5c9.7-3.5 33.9-10.9 68.9-13.8v13.8h-68.9zm68.9-72.7v46.8l-26.2-26.2c-1.9-1.9-4.5-3-7.3-3s-5.4 1.1-7.3 3l-26.3 26.3-.9-.9c-1.9-1.9-4.5-3-7.3-3s-5.4 1.1-7.3 3l-18.8 18.8V225h101.4z"/>
                    <path d="M232.8 254c4.6 0 8.3-3.7 8.3-8.3s-3.7-8.3-8.3-8.3-8.3 3.7-8.3 8.3 3.7 8.3 8.3 8.3zm0-14.9c3.6 0 6.6 2.9 6.6 6.6s-2.9 6.6-6.6 6.6-6.6-2.9-6.6-6.6 3-6.6 6.6-6.6z"/>
                  </svg>
                </div>
              `;
            }

            html += `
                </div>
                <div class="ai-brands-card-content-{{ ai_gen_id }}">
                  <h3 class="ai-brands-card-title-{{ ai_gen_id }}">${this.escapeHtml(collection.title)}</h3>
                </div>
              </a>
            `;
          });

          html += `
              </div>
            </div>
          `;
        });

        this.brandsContent.innerHTML = html;
      }

      filterBrands(searchTerm) {
        if (!searchTerm.trim()) {
          this.renderBrands();
          this.updateAZNavigation();
          return;
        }

        const term = searchTerm.toLowerCase();
        const filtered = {};

        Object.keys(this.groupedCollections).forEach(letter => {
          const matchingCollections = this.groupedCollections[letter].filter(collection =>
            collection.title.toLowerCase().includes(term)
          );

          if (matchingCollections.length > 0) {
            filtered[letter] = matchingCollections;
          }
        });

        this.renderBrands(filtered);
        this.updateAZNavigation(Object.keys(filtered));
      }

      updateAZNavigation(activeLetters = null) {
        const availableLetters = activeLetters || Object.keys(this.groupedCollections);
        
        this.azLetters.forEach(letterEl => {
          const letter = letterEl.getAttribute('data-letter');
          if (availableLetters.includes(letter)) {
            letterEl.classList.remove('disabled');
          } else {
            letterEl.classList.add('disabled');
          }
        });
      }

      escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      }
    }

    customElements.define('all-brands-page-{{ ai_gen_id }}', AllBrandsPage{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "All brands page",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Page content"
    },
    {
      "type": "text",
      "id": "page_title",
      "label": "Page title",
      "default": "All Brands"
    },
    {
      "type": "text",
      "id": "page_subtitle",
      "label": "Page subtitle",
      "default": "Explore our complete collection of brands"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 48
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtitle size",
      "default": 18
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search bar",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search brands..."
    },
    {
      "type": "color",
      "id": "search_bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "search_border_color",
      "label": "Border",
      "default": "#e0e0e0"
    },
    {
      "type": "color",
      "id": "search_focus_color",
      "label": "Focus border",
