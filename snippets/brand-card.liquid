<a href="{{ collection.url }}" class="brand-item">
  {% if collection.image %}
    <img
      src="{{ collection.image | image_url: width: 300, height: 300, crop: "center" }}"
      alt="{{ collection.title }}"
      loading="lazy"
      width="300"
      height="300"
    >
  {% endif %}
  <span>{{ collection.title }}</span>
</a>

<style>
.brand-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16px;
  border: 1px solid #eee;
  border-radius: 8px;
  text-decoration: none;
  color: #000;
  transition: all .2s ease;
}

.brand-item img {
  max-height: 80px;
  object-fit: contain;
  margin-bottom: 10px;
}

.brand-item:hover {
  background: #f5f5f5;
}
</style>
